fn oracle < alpha | > (x : & alpha # bot qbit , y : & alpha # bot qbit , z : # bot qbit) -> # bot qbit {
    let z = qif x {
        let z2 = qif y {
            let z3 = Z(z) ;
            z3
        } else {
            noop ;
            z
        } ;
        z2
    } else {
        noop ;
        z
    } ;
    z
} ;

fn diffusion_phase < alpha | > (x : & alpha # bot qbit , y : & alpha # bot qbit , z : # bot qbit) -> # bot qbit {
    let z = qif x {
        noop ;
        z
    } else {
        let z2 = qif y {
            noop ;
            z
        } else {
            let za = [X](z) ;
            let zb = Z(za) ;
            let zc = [X](zb) ;
            zc
        } ;
        z2
    } ;
    z
} ;

fn grover_diffusion < | > (x : # bot qbit , y : # bot qbit , z : # bot qbit) -> # bot qbit * # bot qbit * # bot qbit {
    let x = H(x) ;
    let y = H(y) ;
    let z = H(z) ;
    newlft alpha ;
    let rx = &alpha x ;
    let ry = &alpha y ;
    let z = diffusion_phase<alpha>(rx, ry, z) ;
    endlft alpha ;
    let x = H(x) ;
    let y = H(y) ;
    let z = H(z) ;
    let xy = (x, y) ;
    let xyz = (xy, z) ;
    xyz
} ;

fn grover < | > (x : # bot qbit , y : # bot qbit , z : # bot qbit) -> # top bool * # top bool * # top bool {
    let x = H(x) ;
    let y = H(y) ;
    let z = H(z) ;
    newlft alpha1 ;
    let rx1 = &alpha1 x ;
    let ry1 = &alpha1 y ;
    let z = oracle<alpha1>(rx1, ry1, z) ;
    endlft alpha1 ;
    let step1 = grover_diffusion<>(x, y, z) ;
    let (xy1, z) = step1 ;
    let (x, y) = xy1 ;
    newlft alpha2 ;
    let rx2 = &alpha2 x ;
    let ry2 = &alpha2 y ;
    let z = oracle<alpha2>(rx2, ry2, z) ;
    endlft alpha2 ;
    let step2 = grover_diffusion<>(x, y, z) ;
    let (xy2, z) = step2 ;
    let (x, y) = xy2 ;
    let bx = meas(x) ;
    let by = meas(y) ;
    let bz = meas(z) ;
    let bxy = (bx, by) ;
    let bxyz = (bxy, bz) ;
    bxyz
}
